    border: none;
    background: transparent;
}

QRadioButton {
    color: #c0caf5;
    font-size: 10pt;
    spacing: 8px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 9px;
    border: 2px solid #565f89;
    background-color: #16161e;
}
QRadioButton::indicator:hover {
    border: 2px solid #7aa2f7;
}
QRadioButton::indicator:checked {
    border: 2px solid #7aa2f7;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #7aa2f7, stop:0.45 #7aa2f7, stop:0.55 #16161e, stop:1 #16161e);
}

QPushButton {
    border-radius: 8px;
    padding: 9px 16px;
    font-size: 10pt;
    font-weight: bold;
}
QPushButton#btnComenzar {
    background-color: #7aa2f7;
    color: #1a1b26;
    border: none;
}
QPushButton#btnComenzar:hover {
    background-color: #8fb0fa;
}
QPushButton#btnComenzar:pressed {
    background-color: #6a92e6;
}
QPushButton#btnBorrarTodo {
    background-color: transparent;
    color: #f7768e;
    border: 1px solid #f7768e;
}
QPushButton#btnBorrarTodo:hover {
    background-color: #f7768e;
    color: #1a1b26;
}
QPushButton#btnBorrarTodo:pressed {
    background-color: #e0657c;
    color: #1a1b26;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2f3549;
    border-radius: 5px;
